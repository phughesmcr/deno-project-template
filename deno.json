{
  "name": "@phughesmcr/deno-project-template",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Deno 2.9 library template.",
  "exports": "./mod.ts",
  "imports": {
    "@std/assert": "jsr:@std/assert@1" // dev
  },
  "minimumDependencyAge": "P2D",
  "compilerOptions": {
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended", "jsr"],
      "include": [
        "explicit-module-boundary-types",
        "no-node-globals",
        "no-process-global"
      ]
    }
  },
  "fmt": {
    "exclude": ["**/*.md", "LICENSE"]
  },
  "tasks": {
    "dev": "deno test --watch",
    "test": "deno test",
    "check": "deno fmt --check && deno lint && deno check mod.ts mod_test.ts && deno doc --lint mod.ts",
    "ci": "deno task check && deno task test",
    "fix": "deno fmt && deno lint --fix"
  },
  "publish": {
    "exclude": [
      "**/*_test.ts",
      "**/*.test.ts",
      "**/*_bench.ts",
      "**/*.bench.ts",
      "deno.lock",
      ".editorconfig",
      ".gitattributes",
      ".github",
      ".vscode",
      ".cursor",
      ".tool-versions",
      "AGENTS.md"
    ]
  }
}
