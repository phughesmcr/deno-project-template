{
  "name": "@phughesmcr/deno-project-template",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Deno 2.9 library template.",
  "exports": "./src/mod.ts",
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/yaml": "jsr:@std/yaml@1"
  },
  "minimumDependencyAge": "P2D",
  "compilerOptions": {
    "erasableSyntaxOnly": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true
  },
  "lint": {
    "plugins": ["./lint/plugin.ts"],
    "rules": {
      "tags": ["recommended", "jsr"],
      "include": [
        "camelcase",
        "default-param-last",
        "eqeqeq",
        "explicit-module-boundary-types",
        "guard-for-in",
        "no-eval",
        "no-external-import",
        "no-implicit-declare-namespace-export",
        "no-inferrable-types",
        "no-node-globals",
        "no-non-null-assertion",
        "no-process-global",
        "no-self-compare",
        "no-sparse-arrays",
        "no-sync-fn-in-async-fn",
        "no-throw-literal",
        "no-useless-rename",
        "single-var-declarator",
        "triple-slash-reference"
      ]
    }
  },
  "test": {
    "include": ["tests/"]
  },
  "fmt": {
    "useTabs": false,
    "indentWidth": 2,
    "lineWidth": 80,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "always",
    "bracePosition": "sameLine",
    "nextControlFlowPosition": "sameLine",
    "operatorPosition": "sameLine",
    "useBraces": "whenNotSingleLine",
    "trailingCommas": "onlyMultiLine",
    "quoteProps": "asNeeded",
    "typeLiteral.separatorKind": "semiColon",
    "sortNamedImports": "caseInsensitive",
    "sortNamedExports": "caseInsensitive",
    "newLineKind": "lf",
    "exclude": ["**/*.md", ".claude/**/*.md", "LICENSE"]
  },
  "tasks": {
    "dev": "deno test --allow-read --allow-write --allow-run=bash,deno,git --watch",
    "test": "deno test --allow-read --allow-write --allow-run=bash,deno,git",
    "check": "deno fmt --check && deno lint && deno check src/mod.ts tests/ && deno doc --lint src/mod.ts",
    "ci": "deno task check && deno task test",
    "fix": "deno fmt && deno lint --fix"
  },
  "publish": {
    "exclude": [
      "tests/",
      ".ignore",
      "**/*_test.ts",
      "**/*.test.ts",
      "**/*_bench.ts",
      "**/*.bench.ts",
      ".editorconfig",
      ".gitattributes",
      ".github",
      ".vscode",
      ".cursor",
      "lint/",
      ".tool-versions",
      ".env",
      ".env.*",
      ".agents/",
      ".claude/",
      "AGENTS.md"
    ]
  }
}
