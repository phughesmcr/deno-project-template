{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-5-5",
  "effortLevel": "medium",
  "env": {
    "CLAUDE_CODE_DISABLE_ARTIFACT": "1",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "300000"
  },
  "skillOverrides": {
    "anthropic-skills:docx": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:xlsx": "off",
    "anthropic-skills:pdf": "off",
    "anthropic-skills:docs": "off",
    "anthropic-skills:computer-use": "off",
    "anthropic-skills:chrome-browser": "off",
    "anthropic-skills:built-in-browser": "off",
    "anthropic-skills:artifact-emulator": "off",
    "anthropic-skills:setup-claude": "off",
    "cowork-plugin-management:cowork-plugin-customizer": "off",
    "cowork-plugin-management:create-cowork-plugin": "off",
    "plugin-authoring": "off",
    "dataviz": "off",
    "artifact-design": "off",
    "artifact-diagramming": "off",
    "artifact-capabilities": "off"
  },
  "disableClaudeAiConnectors": true,
  "disableWorkflows": true,
  "disableRemoteControl": true,
  "disableBundledSkills": true,
  "permissions": {
    "allow": [
      "Bash(deno task *)",
      "Bash(deno test *)",
      "Bash(deno fmt *)",
      "Bash(deno lint *)",
      "Bash(deno check *)",
      "Bash(deno doc *)",
      "Bash(deno info *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git ls-files *)",
      "Bash(git ls-tree *)",
      "Bash(git check-ignore *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git merge *)",
      "Bash(rg *)",
      "Bash(shasum *)",
      "Bash(lsof *)",
      "Bash(ps *)",
      "WebSearch"
    ],
    "deny": [
      "mcp__visualize",
      "mcp__scheduled-tasks",
      "SearchPlugins",
      "SuggestPluginInstall",
      "SuggestSkills",
      "ScheduleWakeup"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "deno run --quiet --allow-read --allow-env=CLAUDE_PROJECT_DIR \"$CLAUDE_PROJECT_DIR/.claude/hooks/hook.ts\" session"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "deno run --quiet --allow-read --allow-write=\"${TMPDIR:-/tmp}/claude-hooks\" --allow-run=deno,git --allow-env=CLAUDE_PROJECT_DIR,TMPDIR,CONTEXT_BUDGET_WARN \"$CLAUDE_PROJECT_DIR/.claude/hooks/hook.ts\" filter"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "deno run --quiet --allow-read --allow-write=\"${TMPDIR:-/tmp}/claude-hooks\" --allow-run=deno,git --allow-env=CLAUDE_PROJECT_DIR,TMPDIR,CONTEXT_BUDGET_WARN \"$CLAUDE_PROJECT_DIR/.claude/hooks/hook.ts\" format"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "deno run --quiet --allow-read --allow-write=\"${TMPDIR:-/tmp}/claude-hooks\" --allow-run=deno,git --allow-env=CLAUDE_PROJECT_DIR,TMPDIR,CONTEXT_BUDGET_WARN \"$CLAUDE_PROJECT_DIR/.claude/hooks/hook.ts\" budget"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "deno run --quiet --allow-read --allow-write=\"${TMPDIR:-/tmp}/claude-hooks\" --allow-run=deno,git --allow-env=CLAUDE_PROJECT_DIR,TMPDIR,CONTEXT_BUDGET_WARN \"$CLAUDE_PROJECT_DIR/.claude/hooks/hook.ts\" prompt"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "deno run --quiet --allow-read --allow-write=\"${TMPDIR:-/tmp}/claude-hooks\" --allow-run=deno,git --allow-env=CLAUDE_PROJECT_DIR,TMPDIR,CONTEXT_BUDGET_WARN \"$CLAUDE_PROJECT_DIR/.claude/hooks/hook.ts\" stop",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
