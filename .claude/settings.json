{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-5-5",
  "effortLevel": "medium",
  "statusLine": {
    "type": "command",
    "command": "deno run --quiet --allow-read --allow-run=git --allow-env=CLAUDE_PROJECT_DIR,CONTEXT_BUDGET_WARN \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/hook.ts\" statusline"
  },
  "worktree": {
    "baseRef": "head"
  },
  "env": {
    "CLAUDE_CODE_DISABLE_ARTIFACT": "1",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "300000"
  },
  "skillOverrides": {
    "anthropic-skills:docx": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:xlsx": "off",
    "anthropic-skills:pdf": "off",
    "anthropic-skills:docs": "off",
    "anthropic-skills:computer-use": "off",
    "anthropic-skills:chrome-browser": "off",
    "anthropic-skills:built-in-browser": "off",
    "anthropic-skills:artifact-emulator": "off",
    "anthropic-skills:setup-claude": "off",
    "cowork-plugin-management:cowork-plugin-customizer": "off",
    "cowork-plugin-management:create-cowork-plugin": "off",
    "plugin-authoring": "off",
    "dataviz": "off",
    "artifact-design": "off",
    "artifact-diagramming": "off",
    "artifact-capabilities": "off"
  },
  "disableClaudeAiConnectors": true,
  "disableWorkflows": true,
  "disableRemoteControl": true,
  "disableBundledSkills": true,
  "permissions": {
    "allow": [
      "Bash(deno task *)",
      "Bash(deno test *)",
      "Bash(deno fmt *)",
      "Bash(deno lint *)",
      "Bash(deno check *)",
      "Bash(deno doc *)",
      "Bash(deno info *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git ls-files *)",
      "Bash(git ls-tree *)",
      "Bash(git check-ignore *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git merge *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(git pull --ff-only *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(rg *)",
      "Bash(shasum *)",
      "Bash(lsof *)",
      "Bash(ps *)",
      "WebSearch"
    ],
    "deny": [
      "mcp__visualize",
      "mcp__scheduled-tasks",
      "SearchPlugins",
      "SuggestPluginInstall",
      "SuggestSkills",
      "ScheduleWakeup",
      "Agent(Explore)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r -f *)",
      "Bash(rm -f -r *)",
      "Bash(rm -Rf *)",
      "Bash(rm -fR *)",
      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(rm -Rf*)",
      "Bash(rm -fR*)",
      "Bash(rm -R -f *)",
      "Bash(rm -f -R *)",
      "Bash(rm --recursive --force*)",
      "Bash(rm --force --recursive*)",
      "Bash(rm -r --force*)",
      "Bash(rm -R --force*)",
      "Bash(rm --force -r*)",
      "Bash(rm --force -R*)",
      "Bash(rm --recursive -f*)",
      "Bash(rm -f --recursive*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git * push *--force*)",
      "Bash(git *push* -f*)",
      "Bash(git *push* -uf*)",
      "Bash(git *push* +*)",
      "Bash(git reset --hard*)",
