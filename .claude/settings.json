      "PowerShell(git *clean* --force*)",
      "PowerShell(git *clean* -df*)",
      "PowerShell(git *clean* -qf*)",
      "PowerShell(git *clean* -xf*)",
      "PowerShell(git *clean* -Xf*)",
      "PowerShell(git *clean* -dqf*)",
      "PowerShell(git *clean* -qdf*)",
      "PowerShell(git *clean* -dxf*)",
      "PowerShell(git *clean* -xdf*)",
      "PowerShell(git *clean* -dXf*)",
      "PowerShell(git *clean* -Xdf*)",
      "PowerShell(git *clean* -qxf*)",
      "PowerShell(git *clean* -xqf*)",
      "PowerShell(git *clean* -qXf*)",
      "PowerShell(git *clean* -Xqf*)",
      "PowerShell(git *clean* -dqxf*)",
      "PowerShell(git *clean* -dxqf*)",
      "PowerShell(git *clean* -qdxf*)",
      "PowerShell(git *clean* -qxdf*)",
      "PowerShell(git *clean* -xdqf*)",
      "PowerShell(git *clean* -xqdf*)",
      "PowerShell(git *clean* -dqXf*)",
      "PowerShell(git *clean* -dXqf*)",
      "PowerShell(git *clean* -qdXf*)",
      "PowerShell(git *clean* -qXdf*)",
      "PowerShell(git *clean* -Xdqf*)",
      "PowerShell(git *clean* -Xqdf*)",
      "PowerShell(Get-Content *.env*)",
      "PowerShell(*>.env*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "deno run --quiet --allow-read --allow-write=\"$CLAUDE_PROJECT_DIR/.claude/handoff.md\" --allow-run=deno --allow-env=CLAUDE_PROJECT_DIR \"$CLAUDE_PROJECT_DIR/.claude/hooks/hook.ts\" session"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "deno run --quiet --allow-read --allow-write=\"${TMPDIR:-/tmp}/claude-hooks\" --allow-run=deno,git --allow-env=CLAUDE_PROJECT_DIR,TMPDIR,CONTEXT_BUDGET_WARN \"$CLAUDE_PROJECT_DIR/.claude/hooks/hook.ts\" filter"
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "deno run --quiet --allow-read --allow-write=\"${TMPDIR:-/tmp}/claude-hooks\" --allow-run=git --allow-env=CLAUDE_PROJECT_DIR,TMPDIR \"$CLAUDE_PROJECT_DIR/.claude/hooks/hook.ts\" track"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "deno run --quiet --allow-read --allow-write=\"${TMPDIR:-/tmp}/claude-hooks\" --allow-run=deno,git --allow-env=CLAUDE_PROJECT_DIR,TMPDIR,CONTEXT_BUDGET_WARN \"$CLAUDE_PROJECT_DIR/.claude/hooks/hook.ts\" format"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "deno run --quiet --allow-read --allow-write=\"${TMPDIR:-/tmp}/claude-hooks\" --allow-run=deno,git --allow-env=CLAUDE_PROJECT_DIR,TMPDIR,CONTEXT_BUDGET_WARN \"$CLAUDE_PROJECT_DIR/.claude/hooks/hook.ts\" budget"
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "deno run --quiet --allow-read --allow-write=\"${TMPDIR:-/tmp}/claude-hooks\" --allow-run=git --allow-env=CLAUDE_PROJECT_DIR,TMPDIR \"$CLAUDE_PROJECT_DIR/.claude/hooks/hook.ts\" track"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "deno run --quiet --allow-read --allow-write=\"${TMPDIR:-/tmp}/claude-hooks\" --allow-run=git --allow-env=CLAUDE_PROJECT_DIR,TMPDIR \"$CLAUDE_PROJECT_DIR/.claude/hooks/hook.ts\" track"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "deno run --quiet --allow-read --allow-write=\"${TMPDIR:-/tmp}/claude-hooks\" --allow-env=CLAUDE_PROJECT_DIR,TMPDIR,CONTEXT_BUDGET_WARN \"$CLAUDE_PROJECT_DIR/.claude/hooks/hook.ts\" prompt"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "deno run --quiet --allow-read --allow-write=\"${TMPDIR:-/tmp}/claude-hooks\" --allow-run=deno --allow-env=CLAUDE_PROJECT_DIR,TMPDIR,CONTEXT_BUDGET_WARN \"$CLAUDE_PROJECT_DIR/.claude/hooks/hook.ts\" stop",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
