      "Bash(git clean* -f*)",
      "Bash(git clean* --force*)",
      "Bash(git clean* -df*)",
      "Bash(git clean* -dxf*)",
      "Bash(git clean* -dXf*)",
      "Bash(git clean* -xf*)",
      "Bash(git clean* -xdf*)",
      "Bash(git clean* -Xf*)",
      "Bash(git clean* -Xdf*)",
      "Bash(git clean* -qf*)",
      "Bash(git clean* -qdf*)",
      "Bash(git *clean* -f*)",
      "Bash(git *clean* --force*)",
      "Bash(git *clean* -df*)",
      "Bash(git *clean* -qf*)",
      "Bash(git *clean* -xf*)",
      "Bash(git *clean* -Xf*)",
      "Bash(git *clean* -dqf*)",
      "Bash(git *clean* -qdf*)",
      "Bash(git *clean* -dxf*)",
      "Bash(git *clean* -xdf*)",
      "Bash(git *clean* -dXf*)",
      "Bash(git *clean* -Xdf*)",
      "Bash(git *clean* -qxf*)",
      "Bash(git *clean* -xqf*)",
      "Bash(git *clean* -qXf*)",
      "Bash(git *clean* -Xqf*)",
      "Bash(git *clean* -dqxf*)",
      "Bash(git *clean* -dxqf*)",
      "Bash(git *clean* -qdxf*)",
      "Bash(git *clean* -qxdf*)",
      "Bash(git *clean* -xdqf*)",
      "Bash(git *clean* -xqdf*)",
      "Bash(git *clean* -dqXf*)",
      "Bash(git *clean* -dXqf*)",
      "Bash(git *clean* -qdXf*)",
      "Bash(git *clean* -qXdf*)",
      "Bash(git *clean* -Xdqf*)",
      "Bash(git *clean* -Xqdf*)",
      "Bash(sudo *)",
      "Bash(chmod 777*)",
      "Read(**/.env*)",
      "Edit(**/.env*)",
      "Edit(**/*.uasset)",
      "Edit(**/*.umap)",
      "PowerShell(Remove-Item *-Recurse*)",
      "PowerShell(Remove-Item * -r*)",
      "PowerShell(Remove-Item -r*)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push -f *)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push * +*)",
      "PowerShell(git * push *--force*)",
      "PowerShell(git *push* -f*)",
      "PowerShell(git *push* -uf*)",
      "PowerShell(git *push* +*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git *reset *--hard*)",
      "PowerShell(git clean* -f*)",
      "PowerShell(git clean* --force*)",
      "PowerShell(git clean* -df*)",
      "PowerShell(git clean* -dxf*)",
      "PowerShell(git clean* -dXf*)",
